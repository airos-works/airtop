resource vector_icon { import "AirTop.hvif" };
resource app_signature "application/x-vnd.AirOS-AirTop";
resource app_flags B_SINGLE_LAUNCH;
resource app_version {
    major = 1, middle = 2, minor = 0, variety = B_APPV_FINAL, internal = 1,
    short_info = "AirTop system observatory",
    long_info = "A native system monitor for Air/OS and Haiku. CPU, memory, network, processes, volumes and thermal sensors; CPU, network and temperature on an auxiliary display."
};
